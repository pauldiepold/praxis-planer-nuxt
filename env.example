# ---------------------------------------------------------------------------
# Pflege-Planer (nuxt-auth-utils) — eigene GitHub-OAuth-App
# ---------------------------------------------------------------------------
NUXT_SESSION_PASSWORD=your-super-secret-session-password-with-at-least-32-characters
# Kommagetrennte GitHub-*Logins* (nicht E-Mails), die den Planer nutzen dürfen.
NUXT_ALLOWED_USERS=your-github-username,another-github-username
NUXT_OAUTH_GITHUB_CLIENT_ID=your-github-client-id
NUXT_OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# ---------------------------------------------------------------------------
# Nuxt Studio (/_studio) — zweite, davon unabhängige GitHub-OAuth-App
# ---------------------------------------------------------------------------
# Muss auch zur BUILD-Zeit gesetzt sein: nuxt-studio leitet das Passwort des
# `studio-session`-Cookies beim Build aus md5(clientId + clientSecret) ab.
# Fehlen die Werte im Build, ist das Passwort md5('') — also öffentlich bekannt
# und die Session fälschbar.
STUDIO_GITHUB_CLIENT_ID=your-studio-github-client-id
STUDIO_GITHUB_CLIENT_SECRET=your-studio-github-client-secret
# Kommagetrennte GitHub-Primär-*E-Mails* (nicht Logins), die das Studio öffnen
# dürfen. Ohne diese Variable gibt es KEINE Zugangsprüfung: jeder GitHub-Account
# erhält eine Studio-Session und damit Zugriff auf /__nuxt_studio/medias/** und
# /__nuxt_studio/ai/**. Publish scheitert dann zwar an den Repo-Rechten, der
# Rest nicht.
STUDIO_GITHUB_MODERATORS=your-github-email,another-github-email

# Database (if needed)
# DATABASE_URL=your-database-url
